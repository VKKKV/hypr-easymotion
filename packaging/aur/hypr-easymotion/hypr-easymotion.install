post_install() {
  cat <<'EOF'
hypr-easymotion installed.

Lua module: /usr/share/lua/5.5/easymotion  ->  require("easymotion")
Renderer:   /usr/bin/easymotion-render    (the default renderer path)

Bind it from the Hyprland Lua config:

  local easymotion = require("easymotion")
  hl.bind("SUPER + R", function()
    local ok, err = easymotion.activate()
    if not ok then print("easymotion: " .. tostring(err)) end
  end)

Full documentation: /usr/share/doc/hypr-easymotion/README.md
EOF
}

post_upgrade() {
  post_install
}
